# Copia este archivo a `.env` y ajusta los valores.
# En PowerShell:  Copy-Item .env.example .env
# En Linux/Ubuntu: cp .env.example .env

# Puerto público en el host (host:contenedor -> 8000)
HUB_PORT=8000

# Usuarios admin separados por coma (deben registrarse en /hub/signup)
JUPYTERHUB_ADMIN=admin

# Límites por usuario (cada notebook server)
USER_MEM_LIMIT=2G
USER_CPU_LIMIT=1.0

# nbgrader: identificador del curso (debe ser slug, sin espacios)
# El admin pertenece automáticamente al grupo `formgrade-<course_id>`.
NBGRADER_COURSE_ID=curso-2026
NBGRADER_TIMEZONE=America/Bogota
