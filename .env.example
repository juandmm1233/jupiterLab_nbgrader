# Copia este archivo a `.env` y ajusta los valores.
# En PowerShell:  Copy-Item .env.example .env
# En Linux/Ubuntu: cp .env.example .env

# Puerto público en el host (host:contenedor -> 8000)
HUB_PORT=8000

# Usuarios admin separados por coma (deben registrarse en /hub/signup)
JUPYTERHUB_ADMIN=admin

# Límites por usuario (cada notebook server)
USER_MEM_LIMIT=2G
USER_CPU_LIMIT=1.0
